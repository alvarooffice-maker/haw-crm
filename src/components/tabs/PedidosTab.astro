<!-- ══════════════════ PEDIDOS ══════════════════ -->
<div class="tab-panel" id="tab-pedidos">
  <!-- ── toolbar ── -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px">
    <div class="filters" id="ped-list-filters" style="display:none;margin-bottom:0">
      <button class="fb active" onclick="filterPedidos('todos',this)">Todos</button>
      <button class="fb" onclick="filterPedidos('em_laboratorio',this)">Em Lab</button>
      <button class="fb" onclick="filterPedidos('pronto',this)">Prontos</button>
      <button class="fb" onclick="filterPedidos('entregue',this)">Entregues</button>
      <button class="fb" onclick="filterPedidos('perdido',this)">Perdidos</button>
    </div>
    <div style="display:flex;gap:6px;align-items:center;margin-left:auto">
      <span class="badge badge-gold" id="cnt-ped-badge">0</span>
      <button class="btn btn-ghost" style="padding:5px 12px;font-size:11px;display:flex;align-items:center;gap:5px" onclick="novaOrdemServico()">📋 Nova OS</button>
      <div style="display:flex;gap:3px;background:var(--off);border:1px solid var(--border-light);border-radius:var(--rad);padding:3px">
        <button id="ped-view-kb" class="fb active" style="margin:0;padding:5px 12px;font-size:11px" onclick="setPedidosView('kanban')">🗂 Kanban</button>
        <button id="ped-view-li" class="fb" style="margin:0;padding:5px 12px;font-size:11px" onclick="setPedidosView('lista')">☰ Lista</button>
      </div>
    </div>
  </div>
  <!-- ── kanban view ── -->
  <div id="ped-kanban-wrap" style="overflow-x:auto;padding-bottom:12px">
    <div id="ped-kanban-board" style="display:flex;gap:12px;min-width:max-content;align-items:flex-start"></div>
  </div>
  <!-- ── list view ── -->
  <div id="ped-list-wrap" style="display:none">
    <div class="card">
      <div style="overflow-x:auto">
        <table>
          <thead><tr>
            <th style="width:8%">#</th>
            <th style="width:25%">Cliente</th>
            <th style="width:20%">Produto</th>
            <th style="width:12%">Total</th>
            <th style="width:15%">Status</th>
            <th style="width:20%">Ações</th>
          </tr></thead>
          <tbody id="pedidos-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>
