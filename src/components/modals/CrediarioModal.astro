<!-- Modal: Alterar meu PIN -->
<!-- ══════════════════ MODAL CREDIÁRIO ══════════════════ -->
<div class="modal-overlay" id="modal-crediario">
  <div class="modal" style="max-width:620px">
    <div class="modal-header">
      <span class="modal-title" id="modal-cred-title">Novo Crediário</span>
      <button class="modal-close" onclick="closeModal('modal-crediario')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="cred-id">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Cliente *</label>
          <select class="form-input" id="cred-cliente-id" onchange="credOnClienteChange()">
            <option value="">— Selecione o cliente —</option>
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Pedido vinculado (opcional)</label>
          <select class="form-input" id="cred-pedido-id" onchange="credOnPedidoChange()">
            <option value="">— Nenhum —</option>
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1">
          <label class="form-label">Descrição</label>
          <input class="form-input" id="cred-descricao" placeholder="Ex: Óculos completo — armação + lente">
        </div>
        <div class="form-group">
          <label class="form-label">Valor total (R$) *</label>
          <input class="form-input" id="cred-total" type="number" min="0" step="0.01" oninput="credRecalc()" placeholder="0,00">
        </div>
        <div class="form-group">
          <label class="form-label">Entrada (R$)</label>
          <input class="form-input" id="cred-entrada" type="number" min="0" step="0.01" value="0" oninput="credRecalc()" placeholder="0,00">
        </div>
        <div class="form-group">
          <label class="form-label">Nº de parcelas *</label>
          <select class="form-input" id="cred-nparcelas" onchange="credRecalc()">
            <option value="1">1x</option><option value="2">2x</option><option value="3">3x</option>
            <option value="4">4x</option><option value="5">5x</option><option value="6" selected>6x</option>
            <option value="7">7x</option><option value="8">8x</option><option value="9">9x</option>
            <option value="10">10x</option><option value="12">12x</option><option value="18">18x</option><option value="24">24x</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Data 1ª parcela *</label>
          <input class="form-input" id="cred-data1" type="date" oninput="credRecalc()">
        </div>
        <div class="form-group">
          <label class="form-label">Juros de mora (% a.m.)</label>
          <input class="form-input" id="cred-taxa-mora" type="number" min="0" max="5" step="0.01" value="1" placeholder="1,00">
        </div>
        <div class="form-group">
          <label class="form-label">Multa por atraso (%)</label>
          <input class="form-input" id="cred-multa" type="number" min="0" max="2" step="0.01" value="2" placeholder="2,00">
        </div>
      </div>
      <!-- Preview de parcelas -->
      <div id="cred-preview" style="margin-top:16px;display:none">
        <div style="font-size:12px;font-weight:600;color:var(--gold);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px">Pré-visualização das parcelas</div>
        <div style="overflow-x:auto">
          <table style="font-size:12px">
            <thead><tr><th style="width:50px">Nº</th><th>Vencimento</th><th style="text-align:right">Valor</th></tr></thead>
            <tbody id="cred-preview-tbody"></tbody>
          </table>
        </div>
        <div style="text-align:right;font-size:12px;margin-top:6px;color:var(--muted)">
          Valor parcelado: <strong id="cred-preview-total" style="color:var(--gold-deep)">R$ 0,00</strong>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-crediario')">Cancelar</button>
      <button class="btn btn-gold" onclick="salvarCrediario()">💾 Salvar Crediário</button>
    </div>
  </div>
</div>
