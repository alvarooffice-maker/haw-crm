<!-- MODAL PEDIDO -->
<div class="modal-overlay" id="modal-pedido">
  <div class="modal" style="max-width:640px">
    <div class="modal-header">
      <span class="modal-title" id="modal-ped-title">Novo Pedido</span>
      <button class="modal-close" onclick="closeModal('modal-pedido')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="ped-id">
      <div class="form-row"><div class="form-group"><label class="form-label">Cliente *</label><select class="form-input form-select" id="ped-cliente" onchange="onPedClienteChange()"></select></div>
      <div class="form-group"><label class="form-label">Receita</label><select class="form-input form-select" id="ped-receita" onchange="renderSugestaoLentes(this.value)"><option value="">— selecione o cliente primeiro —</option></select></div></div>
      <div id="ped-sugestao-lentes" style="display:none"></div>
      <div class="form-row"><div class="form-group"><label class="form-label">Vendedor *</label><select class="form-input form-select" id="ped-vendedor"></select></div>
      <div class="form-group"><label class="form-label">Status</label><select class="form-input form-select" id="ped-status" onchange="_toggleMotivoPerdaPed()">
        <option value="lead">Lead</option>
        <option value="atendimento" selected>Atendimento</option>
        <option value="proposta_enviada">Proposta Enviada</option>
        <option value="pedido_feito">Pedido Feito</option>
        <option value="em_laboratorio">Em Laboratório</option>
        <option value="pronto">Pronto para entrega</option>
        <option value="entregue">Entregue</option>
        <option value="pos_venda">Pós-venda</option>
        <option value="perdido">Perdido</option>
      </select></div></div>
      <div id="ped-motivo-wrap" style="display:none">
        <div class="form-row">
          <div class="form-group"><label class="form-label">Motivo da perda *</label>
            <select class="form-input form-select" id="ped-motivo" onchange="_toggleMotivoOutroPed()">
              <option value="">— Selecione —</option>
            </select>
          </div>
          <div class="form-group" id="ped-motivo-outro-wrap" style="display:none">
            <label class="form-label">Especifique</label>
            <input class="form-input" id="ped-motivo-outro" placeholder="Descreva o motivo">
          </div>
        </div>
      </div>
      <div class="form-divider">🛍️ Itens do pedido</div>
      <!-- Cabeçalho das colunas -->
      <div style="display:grid;grid-template-columns:2fr 64px 86px 58px 28px;gap:8px;padding:0 0 4px;margin-bottom:2px">
        <span style="font-size:10px;color:var(--muted);font-weight:600">Produto / Serviço</span>
        <span style="font-size:10px;color:var(--muted);font-weight:600;text-align:center">Qtd</span>
        <span style="font-size:10px;color:var(--muted);font-weight:600;text-align:right">Preço R$</span>
        <span style="font-size:10px;color:var(--muted);font-weight:600;text-align:center">Desc %</span>
        <span></span>
      </div>
      <div id="ped-itens-list" style="margin-bottom:10px"></div>
      <button class="btn btn-ghost btn-sm" onclick="addItemPedido()" style="margin-bottom:14px">+ Adicionar item</button>
      <!-- Resumo financeiro -->
      <div style="background:var(--gold-pale);border-radius:var(--rad);padding:12px 14px;margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <span style="font-size:12px;color:var(--gold-deep);font-weight:600">Subtotal dos itens</span>
          <span style="font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--gold-deep)" id="ped-subtotal">R$ 0,00</span>
        </div>
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <div class="form-group" style="flex:0 0 110px">
            <label class="form-label">Desconto geral (%)</label>
            <input class="form-input" id="ped-desconto" type="number" min="0" max="100" step="0.5" value="0" oninput="calcTotal()" style="text-align:center">
          </div>
          <div style="flex:1;padding-bottom:4px">
            <div id="ped-desconto-valor" style="font-size:12px;color:#e07070;font-weight:600;min-height:18px"></div>
            <div id="ped-desconto-economia" style="font-size:11px;color:var(--muted);min-height:14px"></div>
          </div>
          <div style="text-align:right;padding-bottom:2px">
            <div style="font-size:10px;color:var(--gold-deep);font-weight:600;text-transform:uppercase;letter-spacing:.06em">Total final</div>
            <div style="font-family:var(--font-display);font-size:24px;font-weight:700;color:var(--gold-deep)" id="ped-total">R$ 0,00</div>
          </div>
        </div>
      </div>
      <div class="form-row"><div class="form-group"><label class="form-label">Forma de pagamento</label><select class="form-input form-select" id="ped-pgto">
        <option value="">Selecione</option><option>Dinheiro</option><option>Pix</option><option>Cartão de débito</option><option>Cartão de crédito</option><option>Parcelado no cartão</option>
      </select></div>
      <div class="form-group"><label class="form-label">Parcelas</label><select class="form-input form-select" id="ped-parcelas">
        <option value="1">À vista</option><option value="2">2x</option><option value="3">3x</option><option value="4">4x</option><option value="5">5x</option><option value="6">6x</option><option value="10">10x</option><option value="12">12x</option>
      </select></div></div>
      <div class="form-row"><div class="form-group"><label class="form-label">Previsão laboratório</label><input class="form-input" id="ped-prev-lab" type="date"></div>
      <div class="form-group"><label class="form-label">Observações</label><input class="form-input" id="ped-obs" placeholder="Instrução especial, urgência..."></div></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-pedido')">Cancelar</button>
      <button class="btn btn-ghost" onclick="gerarPDF()">📄 Gerar Orçamento PDF</button>
      <button class="btn btn-gold" onclick="salvarPedido()">💾 Salvar Pedido</button>
    </div>
  </div>
</div>
