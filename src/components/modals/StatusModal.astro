<!-- MODAL STATUS PEDIDO -->
<div class="modal-overlay" id="modal-status">
  <div class="modal" style="max-width:400px">
    <div class="modal-header">
      <span class="modal-title">Mover pedido no pipeline</span>
      <button class="modal-close" onclick="closeModal('modal-status')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="st-ped-id">
      <div class="form-group" style="margin-bottom:14px"><label class="form-label">Novo status</label>
        <select class="form-input form-select" id="st-novo" onchange="_toggleMotivoPerda()">
          <option value="lead">Lead</option>
          <option value="atendimento">Atendimento</option>
          <option value="proposta_enviada">Proposta Enviada</option>
          <option value="pedido_feito">Pedido Feito</option>
          <option value="em_laboratorio">Em Laboratório</option>
          <option value="pronto">Pronto para entrega</option>
          <option value="entregue">Entregue</option>
          <option value="pos_venda">Pós-venda</option>
          <option value="perdido">Perdido</option>
        </select>
      </div>
      <div id="st-motivo-wrap" style="display:none;margin-bottom:14px">
        <div class="form-group"><label class="form-label">Motivo da perda *</label>
          <select class="form-input form-select" id="st-motivo" onchange="_toggleMotivoOutro()">
            <option value="">— Selecione —</option>
          </select>
        </div>
        <div class="form-group" id="st-motivo-outro-wrap" style="display:none">
          <label class="form-label">Especifique</label>
          <input class="form-input" id="st-motivo-outro" placeholder="Descreva o motivo">
        </div>
      </div>
      <div class="form-group"><label class="form-label">Observação</label><input class="form-input" id="st-obs" placeholder="Opcional"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-status')">Cancelar</button>
      <button class="btn btn-gold" onclick="confirmarStatus()">✓ Confirmar</button>
    </div>
  </div>
</div>
